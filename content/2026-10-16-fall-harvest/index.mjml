<mjml dir="ltr" lang="en" owa="desktop" version="4.14.1">
  <!-- Based on Mailjet's "New Year Newsletter" template -->
  <mj-head>
    <mj-title>Fall Harvest fundraiser 🍗🦃, book club & more</mj-title>
    <mj-preview>turkey fundraiser, how to support, summer party recap & book club</mj-preview>
    <mj-style inline="inline">
      a {
        text-decoration: underline;
      } 
      .text-content { 
        font-family: Arial, Helvetica, sans-serif; 
        font-size: 16px; 
        line-height: 1.5; 
      }
      .text-content-bold {
        font-weight: bold;
      }
      .text-content-italic {
        font-style: italic;
      }
      .text-content-dark {
        color: #3b3e40;
      } 
      .text-content-light {
        color: #ffffff;
      }
      a.light {
        color: #8ffa67;
      }
      a {
        color: #008bf5;
      }
    </mj-style>
    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
      <style type="text/css">
        :root {
          color-scheme: light dark;
          supported-color-schemes: light dark;
        }
      </style>
    </mj-raw>
  </mj-head>
  <mj-body background-color="#F2F2F2">
    <mj-section padding="0px 0px 0px 0px" text-align="center">
      <mj-column>
        <mj-text
          font-family="Helvetica, Arial, sans-serif"
          padding="4px 10px 4px 10px"
        >
          <p style="text-align: center; margin: 10px 0">
            <span
              style="
                line-height: 23px;
                letter-spacing: normal;
                font-size: 14px;
                color: #3b3e40;
                text-align: left;
                font-family: Arial;
              "
              >October 2026 &nbsp;|&nbsp;
            </span>
            <a href="<%= it.permalink %>" target="_blank">
              <span
                style="
                  line-height: 23px;
                  letter-spacing: normal;
                  font-size: 14px;
                  color: #626DCB;
                  font-family: Arial;
                "
              >
                <b><u>View in your browser</u></b>
              </span>
            </a>
          </p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section
      background-color="#ffffff"
      padding="36px 24px 6px 18px"
      text-align="center"
    >
      <mj-group vertical-align="top">
        <mj-column width="35%" vertical-align="middle">
          <mj-image
            align="left"
            alt="Bed-Stuy Survival Collective logo"
            border="none"
            padding="0px 0px 0px 0px"
            src="<%= it.static_url %>/bssc_logo.png"
            target="_blank"
            title=""
          />
        </mj-column>
        <mj-column width="65%" vertical-align="top">
          <mj-spacer height="50px" />
        </mj-column>
      </mj-group>
    </mj-section>
     <mj-section background-color="#ffffff" padding="16px 24px 0px 24px">
      <mj-column>
        <mj-text
          css-class="text-content text-content-dark"
          font-family="Helvetica, Arial, sans-serif"
          padding="0px 12px 8px 12px"
        >
          <p
            class="text-content text-content-dark"
            style="margin-top: 16px; margin-bottom: 16px"
          >
            Hi neighbors, 
          </p>
          <p
            class="text-content text-content-dark"
            style="margin-top: 16px; margin-bottom: 16px"
          >
            Bed-Stuy Survival Collective (formerly Bed-Stuy Strong) is fundraising to feed at least 150 households this November during our annual Fall Harvest event. You can support us by donating now to help buy your neighbor a turkey (and fresh produce). 🥕 
          </p>
          <p
            class="text-content text-content-dark"
            style="margin-top: 16px; margin-bottom: 16px"
          >
             $40 covers one large turkey, $60 covers a turkey and sides, but any amount at all is welcome.
          </p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section
      padding="0px 0px 0px 0px"
      text-align="center"
    >
      <mj-column>
        <mj-image
          align="center"
          alt="flyer sage green background with yellow text stating BUY YOUR NEIGHBOR A TURKEY. a rendering of a turkey with text $40 BUYS ONE LARGE TURKEY $60 BUYS A TURKEY + SIDES. bottom is yellow with black text VENMO: @BEDSTUYSTRONG CASHAPP: $BEDSTUYSTRONG Zelle: FUND@BEDSTUYSTRONG.COM MENTION 'FALL HARVEST' Bed Stuy Survival Collective logo"
          border="none"
          padding="0px 0px 0px 0px"
          max-height="80%"
          src="turkey_graphic.png"
          href="https://www.instagram.com/p/Dej5Mv7lsrJ/"
          target="_blank"
          title=""
        ></mj-image>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="16px 24px 0px 24px">
      <mj-column>
        <mj-text
          css-class="text-content text-content-dark"
          font-family="Helvetica, Arial, sans-serif"
          padding="0px 12px 8px 12px"
        >
          <p
            class="text-content text-content-dark"
            style="margin-top: 16px; margin-bottom: 16px"
          >
            Everybody deserves accessible, high quality food. Your donation will help us source local food in partnership with 
            <a target="_blank" href="https://brooklynsupportedagriculture.com/pages/brooklynpackers">
            The Brooklyn Packers
            </a>
            . Since 2020, we’ve redistributed around $1.5 million back into our neighborhood and we are only able to do our work due to small, individual donations and local fundraising efforts from people like you. If you want to support our work on a recurring basis, you can sign up to <u>receive a monthly contribution reminder email</u>.
          </p>
          <p
            class="text-content text-content-dark text-content-bold"
            style="margin-top: 16px; margin-bottom: 16px"
          >
            Venmo:  <a href="https://account.venmo.com/u/bedstuystrong" target="_blank">@bedstuystrong</a>
            <br>
            Cashapp: <a href="https://cash.app/$bedstuystrong" target="_blank">$bedstuystrong</a>
            <br>
            Zelle: <u>fund@bedstuystrong.com</u>
            <br>
            mention “fall harvest” in the note
          </p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section 
      background-color="#ffffff"
      padding="12px 12px 12px 12px"
      text-align="center"
    >
      <mj-column border="3px solid #996136">
        <mj-text
          css-class="text-content text-content-dark"
          font-family="Helvetica, Arial, sans-serif"
          padding="0px"
          align="center"
        >
          <h2
            class="text-content text-content-dark"
            style="font-size: 22px; margin-top: 16px; margin-bottom: 16px;"
          >
            🦃 SAVE THE DATE 🦃 
          </h2>
          <p
            class="text-content text-content-dark"
            style="margin-top: 16px; font-size: 15px;"
          >
            The Fall Harvest will take place on <b>Sunday, November 22nd</b> starting at 2 pm.
          </p>
        </mj-text>
        <mj-button 
          background-color="#dabd5f" 
          color="#000000"
          font-size="16px" 
          font-family="Helvetica, Arial, sans-serif" 
          font-weight="bold"
          border-radius="8px"
          href="https://docs.google.com/forms/d/e/1FAIpQLSeez9l3Hu2f-52x1y2z9geGBb14OWks17MLLYYtzGhWzyrMIg/viewform"
          target="_blank"
        >Sign up to volunteer here</mj-button>
        <mj-text
          css-class="text-content text-content-dark"
          font-family="Helvetica, Arial, sans-serif"
          align="center"
          padding="0"
        >
          <p
            class="text-content text-content-dark text-content-italic"
          >
            More information coming soon, stay tuned!
          </p>
        </mj-text>
      </mj-column>
    </mj-section>
   
    <mj-section
      background-color="#6a5885"
      full-width="full-width"
      padding="36px 36px 24px 36px"
    >
      <mj-column>
        <mj-image
          align="center"
          alt=""
          border="none"
          padding="0px 0px 0px 0px"
          src="fall_harvest.png"
          target="_blank"
          title=""
        />
        <mj-text
          font-family="Helvetica, Arial, sans-serif"
          padding-bottom="0px"
          padding-left="10px"
          padding-right="10px"
          padding-top="0px"
          padding="0px 10px 0px 10px"
        >
          <p
            class="text-content text-content-light"
            style="margin-top: 16px; margin-bottom: 16px"
          >
            There are a few other ways you can support this year’s Fall Harvest ✨
          </p>
          <p
            class="text-content text-content-light"
            style="margin-top: 45px; margin-bottom: 10px"
          >
            1. <b>Donate baby essentials</b> to be included in our free store. We are collecting baby diapers (any size), wipes, and formula (the most requested kind is Enfamil NeuroPro Baby Formula). 
          </p>

          <p class="text-content text-content-light" style="margin-top: 16px; margin-bottom: 16px">
            You can drop off items in two ways: 
            <br /><br />
            👉 From now until November 15th; drop off items at
            <ol
            class="text-content text-content-light">
              <li>Cosmo (265 Malcolm X Blvd, Brooklyn, NY 11233)
              Tuesday - Sunday 11 AM - 5 PM 
              </li>
              <li>
              The Nonbinarian Bookstore (1130 President St, Brooklyn, NY 11225)
              Daily (Monday - Sunday) 12 PM - 7 PM
              </li>
            </ol>
          </p>
          <p class="text-content text-content-light">
            👉 One day only, drop off items: Sunday, November 8th at 1320 Fulton Street from 12 - 4 pm, directly with BSSC organizers. 

          </p>
          <p
            class="text-content text-content-light"
            style="margin-top: 45px; margin-bottom: 10px"
          >
          2. Consider <b>purchasing your next</b> read through Bed-Stuy Survival Collective's affiliate link with Bookshop.org
          (<a  class="light" href="http://bookshop.org/shop/bssreads" target="_blank">bookshop.org/shop/bssreads</a>). 
          </p>
          <p class="text-content text-content-light" style="margin-top: 16px; margin-bottom: 16px"> 
            ANY book you purchase after following this link will benefit our reading group's bookshare fund (10% of the purchase to us!), which we use to purchase books to redistribute in our Free Store at the Fall Harvest.
          </p>
          <p
            class="text-content text-content-light"
            style="margin-top: 45px; margin-bottom: 10px"
          >
          3. <b>Organize a mini-fundraiser for us!</b>
          </p>
          <p class="text-content text-content-light" style="margin-top: 16px; margin-bottom: 16px"> 
            There’s a lot of ways to help us raise funds – in the past we’ve received donations from raffles, bake sales, event tickets, and clothing stoop sales. Pick something that’s special to you or just use the resources you’ve got. You can ask people to pay us directly or collect the funds yourself and send them to us if that’s easier. Let us know what you’re planning and we can share it on our social media!
          </p>
        </mj-text>
        <mj-image
            align="center"
            alt="3 sun shapes with text. 1. time to declutter? raffle off a unique item! 2. host a party and donate ticket sales 3. organize a bake sale or lemonade stand on your block"
            border="none"
            padding="0px 0px 0px 0px"
            src="fundraiser_ideas.png"
            target="_blank"
            title=""
          />
        <mj-text
          font-family="Helvetica, Arial, sans-serif"
          padding-bottom="0px"
          padding-left="10px"
          padding-right="10px"
          padding-top="0px"
          padding="0px 10px 0px 10px"
        >
         <p class="text-content text-content-light" style="margin-top: 16px; margin-bottom: 16px"> 
            Shoutout and THANK YOU to the folks who have organized a mini-fundraiser for us this past year! The creativity and care that others are putting in around the neighborhood and then sharing with us has been so meaningful. Each donation, big or small, made an impact in our efforts to redistribute resources within our community. Consider checking out these folks and supporting their work, and seeing what they’ve done for our community fund in the past for some inspiration to do your own thing.
          </p>
           <ul
            class="text-content text-content-light">
              <li>
                <a class="light" href="https://www.instagram.com/thriftyonesbk/" target="_blank">The Thrifty Ones</a>
                 - A group of skateboarders hosting skate jams, kickbacks & flea markets to fundraise for mutual aid efforts. They have hosted many markets in the past year, and sent over a portion of the sales at those events to our community fund. In August they raised $530 for our organization!
              </li>
              <li>
                <a class="light" href="https://www.instagram.com/tadpolereadingseries/" target="_blank">Tadpole Reading Series</a>
                - A seasonal mixed-genre reading series at Tadpole Bar here in Bed-Stuy. In April they hosted a reading on desire, and encouraged donations to our organization.
              </li>
              <li>
                 <a class="light" href="https://www.instagram.com/bkcounter/" target="_blank"> Kalakkal Counter by Dhivya</a>
                - An afterschool and summer camp program that teaches kids in Brooklyn math through hands-on cooking with collectivism and care in the center. Kalakkal Counter hosted some pop-up events around the neighborhood in May, giving away pizza slices & decorate-your-own cupcakes, encouraging sales. $64 was raised over some rainy days and sent over to us.
              </li>
              <li>
                Neighbor O - A neighbor organized a stoop sale in August and sent over $375 to our community fund.
              </li>
            </ul>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section
      background-color="#ffffff"
      padding="24px 24px 24px 24px"
    >
      <mj-column>
      <mj-image
        align="center"
        alt=""
        border="none"
        padding="0px 0px 0px 0px"
        src="summer_party.jpg"
        target="_blank"
        title=""
      />
        <mj-text
          font-family="Helvetica, Arial, sans-serif"
          padding="0px 10px 0px 10px"
        >
          <p class="text-content text-content-dark" style="margin-top: 16px; margin-bottom: 16px">
            THANK YOU to everyone who supported our Summer Party this year, whether you contributed a monetary donation, volunteered at the event, participated in our clothing swap, led a skillshare, or came out to hang and dance. It was another amazing event – we raised around $6,000 dollars and were able to provide: 
          </p>
          <ul class="text-content text-content-dark">
            <li>At least 100 individuals with groceries for a week</li>
            <li>Home, hygiene, + baby essentials</li>
            <li>COVID-19 rapid tests and PPE</li>
            <li>Fresh, hot meals</li>
          </ul>

          <p class="text-content text-content-dark" style="margin-top: 16px; margin-bottom: 16px">
          DJ Professa Prince spun some tunes while we enjoyed free books from The Nonbinarian Book Bike, a community art project, a clothing share and live mending table, various skill shares hosted by Brooklyn Harm Reduction Outreach Cooperative (BKHROC), The Repair Cafe, Artists In Resistance (A.I.R.) NYC., and Bed-Stuy Survival Collective organizers, and more. 
          </p>
          <p class="text-content text-content-dark" style="margin-top: 16px; margin-bottom: 16px">
            In 2021, we gathered for our first Summer Party ever, to mark the end of our emergency response food operation that sustained many households during lockdown. (Many of us, freshly vaccinated💉) That summer, the organizers that remained in BSSC committed themselves to building a more sustainable organizing structure. Five years later, back in August at this year’s Party, we came together to celebrate that vision coming to life. ICYMI, we changed our name, and launched a revamped membership model and food security program in May. This work embodies the dreams we had in 2021. Read more about that HERE. (also link to previous newsletter announcement) 

          </p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section
      background-color="#09346e"
      full-width="full-width"
      padding="18px 0px 0px 0px"
    >
      <mj-column>
        <mj-raw> 
          <div id="bssc"></div>
        </mj-raw>
        <mj-text
          font-family="Helvetica, Arial, sans-serif"
          padding-bottom="0px"
          padding-left="18px"
          padding-right="18px"
          padding-top="0px"
          padding="0px 18px 0px 18px"
        >
          <p
            class="text-content text-content-light"
            style="text-align: center; margin-top: 30px; margin-bottom: 20px"
          >
            ICYMI: Bed-Stuy Strong changed our name. <br /> We are now Bed-Stuy Survival Collective.
          <p>
        </mj-text>
        <mj-image
          align="center"
          alt="Bed-Stuy Strong is now... Bed-Stuy Survival Collective (followed by a collage of photos from our events and our reading group titles)"
          border="none"
          padding="0px 0px 0px 0px"
          src="bssc.png"
          title=""
        />
      </mj-column>
    </mj-section>
   
    <mj-section 
      background-color="linear-gradient(0deg, rgb(37, 144, 232), #1762AB)"
      full-width="full-width"
      padding="60px 30px 20px 30px"
    >
      <mj-group vertical-align="middle">
        <mj-column vertical-align="middle" width="33%">
          <mj-text
            css-class="text-content text-content-dark"
            font-family="Helvetica, Arial, sans-serif"
            padding="0px 10px 0px 10px"
          >
            <p
              class="text-content text-content-light"
              style="
                color: #ffffff;
                text-align: left;
                margin: 10px 0;
              "
            >
              <b>Keep in touch</b>
            </p>
          </mj-text>
        </mj-column>
        <mj-column vertical-align="middle" width="67%">
          <mj-include path="../../includes/social.mjml" />
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-include path="../../includes/footer.mjml" />
  </mj-body>
</mjml>
